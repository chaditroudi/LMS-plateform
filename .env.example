GROQ_API_KEY=your-groq-api-key-here
# Stripe Checkout for paid courses
# Use the full key copied from Stripe, never a shortened value ending with ...
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# For local development, run:
# stripe listen --forward-to http://localhost/api/courses/payments/stripe/webhook
# Stripe Dashboard event destinations will reject localhost URLs.
# Use Stripe CLI locally, or a public https://... URL in Stripe Dashboard.
# Then paste the whsec_... value printed by the CLI below.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=usd
FRONTEND_BASE_URL=http://localhost

# MinIO media storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET=lms-media
