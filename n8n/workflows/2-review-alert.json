{
  "id": "c1d2e3f4-0002-4002-a002-aabbcc000002",
  "name": "LMS - 2. Feedback Pipeline (AI Enrichment)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "review",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000001",
      "name": "Review Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "a1b2c3d4-0002-4002-8002-000000000002"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-tutor-service:8004/api/ai/chat",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ course_id: $('Review Webhook').first().json.body.course_id, message: 'Analyze this student feedback for course ' + $('Review Webhook').first().json.body.course_id + ': ' + $('Review Webhook').first().json.body.comment + ' (rating ' + $('Review Webhook').first().json.body.rating + '/5). Summarize the key concerns and sentiment in one sentence.', history: [] }) }}",
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000002",
      "name": "Enrich with AI Tutor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://analytics-service:8003/api/analytics/events/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event_type: 'review_submitted', user_id: $('Review Webhook').first().json.body.user_id, course_id: $('Review Webhook').first().json.body.course_id, metadata: { rating: $('Review Webhook').first().json.body.rating, comment: $('Review Webhook').first().json.body.comment, ai_summary: $('Enrich with AI Tutor').first().json.reply } }) }}",
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000003",
      "name": "Store Review + AI Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [720, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-rating-low",
              "leftValue": "={{ $('Review Webhook').first().json.body.rating }}",
              "rightValue": 3,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000004",
      "name": "Is Low Rating?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://analytics-service:8003/api/analytics/events/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event_type: 'instructor_notification', user_id: $('Review Webhook').first().json.body.user_id, course_id: $('Review Webhook').first().json.body.course_id, metadata: { alert: 'Low rating - instructor review recommended', rating: $('Review Webhook').first().json.body.rating, ai_summary: $('Enrich with AI Tutor').first().json.reply, action: 'Review course content and reach out to student' } }) }}",
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000005",
      "name": "Send Instructor Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1200, 160]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'processed', event: 'review_submitted', course_id: $('Review Webhook').first().json.body.course_id, rating: $('Review Webhook').first().json.body.rating, notified: $('Review Webhook').first().json.body.rating < 3 } }}",
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000006",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1200, 440]
    }
  ],
  "connections": {
    "Review Webhook": {
      "main": [
        [{ "node": "Enrich with AI Tutor", "type": "main", "index": 0 }]
      ]
    },
    "Enrich with AI Tutor": {
      "main": [
        [{ "node": "Store Review + AI Summary", "type": "main", "index": 0 }]
      ]
    },
    "Store Review + AI Summary": {
      "main": [
        [{ "node": "Is Low Rating?", "type": "main", "index": 0 }]
      ]
    },
    "Is Low Rating?": {
      "main": [
        [{ "node": "Send Instructor Notification", "type": "main", "index": 0 }],
        [{ "node": "Respond to Webhook", "type": "main", "index": 0 }]
      ]
    },
    "Send Instructor Notification": {
      "main": [
        [{ "node": "Respond to Webhook", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
