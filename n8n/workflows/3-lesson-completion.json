{
  "id": "c1d2e3f4-0003-4003-a003-aabbcc000003",
  "name": "LMS - 3. Lesson Completion Tracker",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lesson-complete",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000001",
      "name": "Lesson Complete Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "a1b2c3d4-0003-4003-8003-000000000003"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://analytics-service:8003/api/analytics/events/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event_type: 'lesson_complete', user_id: $('Lesson Complete Webhook').first().json.body.user_id, course_id: $('Lesson Complete Webhook').first().json.body.course_id, lesson_id: $('Lesson Complete Webhook').first().json.body.lesson_id, metadata: { lesson_title: $('Lesson Complete Webhook').first().json.body.lesson_title } }) }}",
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000002",
      "name": "Log Lesson Complete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://course-service:8001/api/courses/' + $('Lesson Complete Webhook').first().json.body.course_id + '/progress/' + $('Lesson Complete Webhook').first().json.body.user_id }}",
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000003",
      "name": "Fetch User Progress",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [720, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-all-complete",
              "leftValue": "={{ $('Lesson Complete Webhook').first().json.body.all_lessons_complete }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000004",
      "name": "Course Completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://analytics-service:8003/api/analytics/events/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event_type: 'course_completed', user_id: $('Lesson Complete Webhook').first().json.body.user_id, course_id: $('Lesson Complete Webhook').first().json.body.course_id, metadata: { completed_at: $now.toISO() } }) }}",
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000005",
      "name": "Emit Course Completion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1200, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'processed', event: 'lesson_complete', user_id: $('Lesson Complete Webhook').first().json.body.user_id, lesson_id: $('Lesson Complete Webhook').first().json.body.lesson_id, course_completed: $('Lesson Complete Webhook').first().json.body.all_lessons_complete === true } }}",
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000006",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1200, 420]
    }
  ],
  "connections": {
    "Lesson Complete Webhook": {
      "main": [
        [{ "node": "Log Lesson Complete", "type": "main", "index": 0 }]
      ]
    },
    "Log Lesson Complete": {
      "main": [
        [{ "node": "Fetch User Progress", "type": "main", "index": 0 }]
      ]
    },
    "Fetch User Progress": {
      "main": [
        [{ "node": "Course Completed?", "type": "main", "index": 0 }]
      ]
    },
    "Course Completed?": {
      "main": [
        [{ "node": "Emit Course Completion", "type": "main", "index": 0 }],
        [{ "node": "Respond OK", "type": "main", "index": 0 }]
      ]
    },
    "Emit Course Completion": {
      "main": [
        [{ "node": "Respond OK", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
